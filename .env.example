# Copie para .env e preencha. O .env em si nunca vai para o git.

# Chave que criptografa as senhas das caixas e as chaves de IA dos usuários.
# Gerar: docker compose run --rm api python -c "from app.crypto import generate_key; print(generate_key())"
# ATENÇÃO: perder esta chave = conectar de novo todas as caixas.
SECRET_ENCRYPTION_KEY=

# Chave que assina o login. Se mudar, todos saem do sistema — sem problema,
# é só entrar de novo.
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Banco de dados
DB_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://boss:change-me@db:5432/boss

# Fila
REDIS_URL=redis://redis:6379/0

# Armazenamento de anexos
S3_USER=boss
S3_PASSWORD=change-me
S3_ENDPOINT=http://minio:9000
S3_BUCKET=attachments

# Análise dos e-mails pelo Claude (se AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Fuso horário — nele são mostradas as datas e calculado o «hoje».
TZ=America/Sao_Paulo

# Cookie de login só por https. Para testar localmente por http — false.
COOKIE_SECURE=true

# Porta do site nesta máquina. 80 se o site for o único aqui. Se a porta 80
# já é usada por um nginx com outros sites — qualquer porta livre (ex. 3300),
# e o nginx publica o site pelo domínio com https.
WEB_PORT=80

# Porta da API nesta máquina (só 127.0.0.1). Troque se a 8080 já estiver
# ocupada por outro projeto no mesmo servidor.
API_PORT=8080

# Quem analisa os e-mails: anthropic (chave Claude), gemini (chave do Google
# AI Studio), openrouter (cadeia de modelos) ou ollama (modelo local).
AI_PROVIDER=gemini
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# OpenRouter: cadeia de modelos gratuitos, separados por vírgula. Acabou o
# limite do primeiro — o pedido vai sozinho para o próximo.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=

# Gemini: chave em https://aistudio.google.com/apikey. Modelos por vírgula,
# em ordem: acabou o limite diário do primeiro — responde o próximo.
# ATENÇÃO: no plano gratuito o Google pode usar os e-mails enviados para
# melhorar os modelos. Para e-mails de clientes — só chave com faturamento
# ativado (Tier 1), onde os dados não são usados.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-3.1-flash-lite

# Cadastro pelo link: qualquer pessoa cria o próprio acesso (página «Criar
# conta») e vê só os próprios e-mails. false — acessos só pelo comando no
# servidor: python -m app.admin add <e-mail>.
REGISTRATION_OPEN=true

# Cada usuário pode colocar a própria chave Gemini (menu do avatar → «Chave
# de IA», ou campo na página de login) — aí os e-mails dele são analisados
# por conta dele. A equipe (criada pelo app.admin) usa sempre a chave do
# servidor. AI_SHARED_KEY — compartilhar a chave do servidor também com quem
# se cadastrou sozinho. false — desconhecidos usam só a própria chave, e os
# seus pedidos não são gastos com os e-mails deles.
AI_SHARED_KEY=false

# Tradução dos e-mails pelo botão «Traduzir para português».
# libretranslate — tradutor próprio no servidor (contêiner translator):
# grátis, sem limites, os e-mails não saem do servidor. ai — pelo modelo de
# análise: melhor, mas gasta pedidos.
TRANSLATOR=libretranslate
# DeepL API Free (deepl.com/pro-api, plano «DeepL API Free») — a melhor
# tradução sem IA generativa, 500 000 caracteres por mês grátis. Com chave —
# traduz o DeepL; acabou a cota — o tradutor próprio. Vazio — direto o próprio.
DEEPL_API_KEY=
# Teto diário de caracteres do DeepL para cada pessoa que se cadastrou sozinha
# (a equipe não tem teto). Passou dele — traduz o tradutor próprio.
DEEPL_MEMBER_DAILY_CHARS=20000
# Idiomas do tradutor próprio (~100–200 MB de disco cada).
TRANSLATOR_LANGUAGES=en,pt,es,fr,de,it,ru,zh,ja,ko,ar

# Resumo diário: a hora (no TZ) em que a IA o prepara e o endereço para onde
# enviá-lo por e-mail. Vazio — o resumo fica só na tela «Resumo».
BRIEF_HOUR=7
BRIEF_EMAIL_TO=

# Analisar só e-mails a partir desta data (AAAA-MM-DD). Vazio — todos.
CLASSIFY_SINCE=
